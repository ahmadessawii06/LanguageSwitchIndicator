<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LanguageSwitchIndicator</AssemblyName>
    <RootNamespace>LanguageSwitchIndicator</RootNamespace>
    <ApplicationIcon>Assets\Icons\LanguageSwitchIndicator.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="developers.json" />
    <Content Include="Licenses\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\Icons\LanguageSwitchIndicator.ico" />
    <EmbeddedResource Include="Assets\Icons\tray_white.ico" />
    <EmbeddedResource Include="Assets\Icons\tray_dark.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
