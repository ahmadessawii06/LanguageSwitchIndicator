<UserControl x:Class="LanguageSwitchIndicator.Views.IndicatorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" UseLayoutRounding="True" SnapsToDevicePixels="True" Focusable="False" IsHitTestVisible="False">
  <Border x:Name="Badge" Margin="24" BorderThickness="1" CornerRadius="22" Padding="20" RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform><TransformGroup><ScaleTransform x:Name="BadgeScale" /><TranslateTransform x:Name="BadgeTranslation" /></TransformGroup></Border.RenderTransform>
    <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.2" RenderingBias="Quality" /></Border.Effect>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border x:Name="Keyboard" Width="78" Height="48" CornerRadius="6" BorderThickness="2" HorizontalAlignment="Center">
        <Grid x:Name="KeyboardKeys" Margin="5" />
      </Border>
      <TextBlock x:Name="LanguageLabel" Text="English" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="NoWrap" />
    </StackPanel>
  </Border>
</UserControl>
