<Window x:Class="LanguageSwitchIndicator.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:LanguageSwitchIndicator.Views"
        Title="Language Switch Indicator" Width="1180" Height="820" MinWidth="620" MinHeight="520" WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Product.xaml" /></ResourceDictionary.MergedDictionaries>
      <DataTemplate x:Key="OptionLabel"><TextBlock Text="{Binding Value}" /></DataTemplate>
      <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,7" /><Setter Property="FontWeight" Value="Medium" /></Style>
      <Style x:Key="Field" TargetType="StackPanel"><Setter Property="Margin" Value="0,0,0,24" /></Style>
      <Style x:Key="SwitchRow" TargetType="Grid"><Setter Property="Margin" Value="0,14,0,14" /></Style>
      <Style TargetType="ui:ToggleSwitch" BasedOn="{StaticResource DefaultUiToggleSwitchStyle}"><Setter Property="OnContent" Value="" /><Setter Property="OffContent" Value="" /><Setter Property="Background" Value="{StaticResource Accent}" /><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="16,0,0,0" /></Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Background="{StaticResource Canvas}">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="224" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="16,26,16,18">
        <StackPanel DockPanel.Dock="Top" Margin="10,0,0,32">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Border Background="{StaticResource Accent}" CornerRadius="10" Width="38" Height="38"><ui:SymbolIcon Symbol="Keyboard24" Foreground="White" FontSize="23" /></Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="Language" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Switch Indicator" FontSize="11" Foreground="{StaticResource Muted}" /></StackPanel>
          </StackPanel>
          <TextBlock Text="A LITTLE CLARITY. EVERY SWITCH." FontSize="9" Foreground="{StaticResource Muted}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Button x:Name="AboutButton" Style="{StaticResource Action}" Click="AboutClicked" HorizontalContentAlignment="Left" AutomationProperties.Name="About the developer">
            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Person24" FontSize="18" Margin="0,0,10,0" /><TextBlock Text="About &amp; Developer" MaxWidth="88" FontSize="12" TextWrapping="Wrap" /></StackPanel>
          </Button>
          <Border Background="{StaticResource AccentSoft}" CornerRadius="9" Padding="12" Margin="0,16,0,0">
            <StackPanel><TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource Accent}" FontWeight="SemiBold" /><TextBlock Text="One indicator. Your active screen." Style="{StaticResource Caption}" Margin="0,4,0,0" /></StackPanel>
          </Border>
        </StackPanel>
        <ListBox x:Name="Navigation" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavigationItem}" SelectionChanged="NavigationChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Settings pages">
          <ListBoxItem Tag="General"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Settings24" FontSize="20" Margin="0,0,12,0" /><TextBlock Text="General" /></StackPanel></ListBoxItem>
          <ListBoxItem Tag="Appearance"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Color24" FontSize="20" Margin="0,0,12,0" /><TextBlock Text="Appearance" /></StackPanel></ListBoxItem>
          <ListBoxItem Tag="Position"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Desktop24" FontSize="20" Margin="0,0,12,0" /><TextBlock Text="Position" /></StackPanel></ListBoxItem>
          <ListBoxItem Tag="Animations"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Flash24" FontSize="20" Margin="0,0,12,0" /><TextBlock Text="Animations" /></StackPanel></ListBoxItem>
          <ListBoxItem Tag="Languages"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="LocalLanguage24" FontSize="20" Margin="0,0,12,0" /><TextBlock Text="Languages" /></StackPanel></ListBoxItem>
          <ListBoxItem Tag="Typing correction" AutomationProperties.Name="Typing correction"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowSwap24" FontSize="20" Margin="0,0,12,0" /><TextBlock Text="Typing correction" TextWrapping="Wrap" /></StackPanel></ListBoxItem>
          <ListBoxItem Tag="Advanced"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Options24" FontSize="20" Margin="0,0,12,0" /><TextBlock Text="Advanced" /></StackPanel></ListBoxItem>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="38" /></Grid.RowDefinitions>
      <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,28,32,28">
        <StackPanel x:Name="PageRoot" MaxWidth="1080" HorizontalAlignment="Stretch">
          <DockPanel Margin="0,0,0,8"><TextBlock Text="WORKSPACE / PREFERENCES" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" /><TextBlock Text="DESKTOP" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource Muted}" /></DockPanel>
          <TextBlock x:Name="PageTitle" Text="General" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,6" />
          <TextBlock x:Name="PageDescription" Text="Your language, always in view. Make the indicator work your way." Foreground="{StaticResource Muted}" Margin="0,0,0,28" LineHeight="22" />

          <StackPanel x:Name="GeneralPage">
            <Border CornerRadius="18" Padding="26" Background="#133D3B">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="IN THE FLOW" FontSize="10" Foreground="#9DDCD1" FontWeight="SemiBold" /><TextBlock Text="{Binding Status}" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,8" /><TextBlock Text="A quiet cue for the language you are about to write." Foreground="#C2DCD7" MaxWidth="430" HorizontalAlignment="Left" /></StackPanel>
                <ui:SymbolIcon Grid.Column="1" Symbol="Keyboard24" Foreground="#72BCAD" FontSize="62" Margin="18,0,0,0" />
              </Grid>
            </Border>
            <TextBlock Text="Indicator" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Surface}"><StackPanel>
              <Grid Style="{StaticResource SwitchRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Enable indicator" FontWeight="SemiBold" /><TextBlock Text="Show a language cue in your active workspace." Style="{StaticResource Caption}" Margin="0,4,0,0" /></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}" AutomationProperties.Name="Enable indicator" /></Grid>
              <Border Height="1" Background="{StaticResource Line}" />
              <Grid Style="{StaticResource SwitchRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Pause for now" FontWeight="SemiBold" /><TextBlock Text="Keep your preferences while taking a break." Style="{StaticResource Caption}" Margin="0,4,0,0" /></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsPaused}" AutomationProperties.Name="Pause indicator" /></Grid>
              <TextBlock Text="Show the indicator when" Style="{StaticResource FieldLabel}" Margin="0,12,0,8" />
              <ComboBox x:Name="TriggerChoice" SelectedValuePath="Key" ItemTemplate="{StaticResource OptionLabel}" SelectedValue="{Binding TriggerMode}" AutomationProperties.Name="Popup trigger" />
            </StackPanel></Border>
            <TextBlock Text="At your next sign-in" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Surface}"><StackPanel>
              <Grid Style="{StaticResource SwitchRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Launch with Windows" FontWeight="SemiBold" /><TextBlock Text="Start automatically when you sign in." Style="{StaticResource Caption}" /></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchAtStartup, ValidatesOnExceptions=True}" AutomationProperties.Name="Launch with Windows" /></Grid>
              <Grid Style="{StaticResource SwitchRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Start in the tray" FontWeight="SemiBold" /><TextBlock Text="Keep the settings window out of your way." Style="{StaticResource Caption}" /></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding StartMinimized}" AutomationProperties.Name="Start in the tray" /></Grid>
            </StackPanel></Border>
          </StackPanel>

          <StackPanel x:Name="AppearancePage" Visibility="Collapsed">
            <Grid x:Name="AppearanceLayout">
              <Grid.ColumnDefinitions><ColumnDefinition x:Name="EditorColumn" Width="*" /><ColumnDefinition x:Name="PreviewColumn" Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Border x:Name="AppearanceEditor" Style="{StaticResource Surface}"><StackPanel>
                <TextBlock Text="Make it feel like you" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" /><TextBlock Text="Changes are saved as you go." Style="{StaticResource Caption}" Margin="0,0,0,24" />
                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Indicator size" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="SizeChoice" SelectedIndex="{Binding IndicatorSize}" AutomationProperties.Name="Indicator size" /></StackPanel>
                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Color mode" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="ThemeChoice" SelectedItem="{Binding Theme}" AutomationProperties.Name="Color mode" /></StackPanel>
                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Typeface" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Typeface" /></StackPanel>
                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Text size · px" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Text size" /></StackPanel>
                <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Custom colors" FontWeight="SemiBold" /><TextBlock Text="Override the theme palette." Style="{StaticResource Caption}" /></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding UseCustomColors}" AutomationProperties.Name="Use custom colors" /></Grid>
                <StackPanel IsEnabled="{Binding UseCustomColors}">
                  <StackPanel Style="{StaticResource Field}"><TextBlock Text="Background · HEX" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Background color" /></StackPanel>
                  <StackPanel Style="{StaticResource Field}"><TextBlock Text="Text &amp; icon · HEX" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Text color" /></StackPanel>
                </StackPanel>
                <Expander Header="Shape &amp; surface" Margin="0,8,0,0"><StackPanel Margin="0,18,0,0">
                  <StackPanel Style="{StaticResource Field}"><TextBlock Text="Minimum width · px" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding PopupWidth, ValidatesOnExceptions=True}" AutomationProperties.Name="Minimum width" /></StackPanel>
                  <StackPanel Style="{StaticResource Field}"><TextBlock Text="Minimum height · px" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding PopupHeight, ValidatesOnExceptions=True}" AutomationProperties.Name="Minimum height" /></StackPanel>
                  <StackPanel Style="{StaticResource Field}"><TextBlock Text="Corner radius · px" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding CornerRadius, ValidatesOnExceptions=True}" AutomationProperties.Name="Corner radius" /></StackPanel>
                  <StackPanel Style="{StaticResource Field}"><TextBlock Text="Opacity · 0.1–1" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding BackgroundOpacity, ValidatesOnExceptions=True}" AutomationProperties.Name="Background opacity" /></StackPanel>
                  <StackPanel Style="{StaticResource Field}"><TextBlock Text="Shadow · 0–1" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding ShadowIntensity, ValidatesOnExceptions=True}" AutomationProperties.Name="Shadow intensity" /></StackPanel>
                </StackPanel></Expander>
              </StackPanel></Border>
              <StackPanel x:Name="PreviewPanel" Grid.Column="1" Margin="22,0,0,0">
                <Border Background="#E7EFED" BorderBrush="#D2E0DC" BorderThickness="1" CornerRadius="18" Padding="18">
                  <StackPanel><DockPanel Margin="0,0,0,18"><TextBlock Text="YOUR WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="#42645D" /><Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="White" CornerRadius="5" Padding="8,3"><TextBlock Text="LIVE" FontSize="9" Foreground="{StaticResource Accent}" /></Border></DockPanel>
                    <Border CornerRadius="12" Background="#FAFCFB" BorderBrush="#CAD8D3" BorderThickness="1" Padding="14">
                      <Grid MinHeight="290"><StackPanel><Border Height="5" Width="60" Background="#CCDAD5" HorizontalAlignment="Left" CornerRadius="2" Margin="0,0,0,18" /><TextBlock Text="A space for your next idea." FontWeight="SemiBold" FontSize="14" /><TextBlock Text="Start typing in any language." Style="{StaticResource Caption}" Margin="0,6,0,0" /><Border Background="#E2EAE6" Height="1" Margin="0,16,0,0" /></StackPanel>
                        <Viewbox MaxWidth="300" MaxHeight="240" StretchDirection="DownOnly" VerticalAlignment="Bottom" HorizontalAlignment="Center"><local:IndicatorView x:Name="LiveIndicator" /></Viewbox>
                      </Grid>
                    </Border>
                    <TextBlock Text="The same indicator you see while typing." Style="{StaticResource Caption}" Margin="0,14,0,0" />
                  </StackPanel>
                </Border>
                <Button Style="{StaticResource Primary}" Click="TestSwitchClicked" Margin="0,16,0,8" AutomationProperties.Name="Test switch in preview"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowSwap24" FontSize="18" Margin="0,0,8,0" /><TextBlock Text="Test switch" Foreground="White" /></StackPanel></Button>
                <TextBlock Text="Try English and Arabic here. Your keyboard layout stays the same." Style="{StaticResource Caption}" />
              </StackPanel>
            </Grid>
          </StackPanel>

          <StackPanel x:Name="PositionPage" Visibility="Collapsed">
            <Border Style="{StaticResource Surface}"><StackPanel>
              <TextBlock Text="A place in your workspace" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Always on the screen where you are writing." Style="{StaticResource Caption}" Margin="0,6,0,20" />
              <Grid x:Name="PositionMap" Height="230" Background="#E7EFED" Margin="0,0,0,20">
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Button Tag="TopLeft" Content="Top left" Grid.Row="0" Grid.Column="0" Click="PositionClicked" Style="{StaticResource Action}" Margin="6" />
                <Button Tag="TopCenter" Content="Top" Grid.Row="0" Grid.Column="1" Click="PositionClicked" Style="{StaticResource Action}" Margin="6" />
                <Button Tag="TopRight" Content="Top right" Grid.Row="0" Grid.Column="2" Click="PositionClicked" Style="{StaticResource Action}" Margin="6" />
                <Button Tag="Center" Content="Center" Grid.Row="1" Grid.Column="1" Click="PositionClicked" Style="{StaticResource Action}" Margin="6" />
                <Button Tag="BottomLeft" Content="Bottom left" Grid.Row="2" Grid.Column="0" Click="PositionClicked" Style="{StaticResource Action}" Margin="6" />
                <Button Tag="BottomCenter" Content="Bottom" Grid.Row="2" Grid.Column="1" Click="PositionClicked" Style="{StaticResource Action}" Margin="6" />
                <Button Tag="BottomRight" Content="Bottom right" Grid.Row="2" Grid.Column="2" Click="PositionClicked" Style="{StaticResource Action}" Margin="6" />
              </Grid>
              <TextBlock Text="Placement" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="PlacementChoice" SelectedValuePath="Key" ItemTemplate="{StaticResource OptionLabel}" SelectedValue="{Binding Placement}" AutomationProperties.Name="Indicator placement" />
              <TextBlock Text="Offsets · px" Style="{StaticResource SectionTitle}" /><TextBlock Text="Fine-tune from the selected position. Custom starts at the top-left of the active screen." Style="{StaticResource Caption}" Margin="0,0,0,18" />
              <StackPanel Style="{StaticResource Field}"><TextBlock Text="Horizontal" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding HorizontalOffset, ValidatesOnExceptions=True}" AutomationProperties.Name="Horizontal offset" /></StackPanel>
              <StackPanel Style="{StaticResource Field}"><TextBlock Text="Vertical" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding VerticalOffset, ValidatesOnExceptions=True}" AutomationProperties.Name="Vertical offset" /></StackPanel>
              <Button Content="Preview on this screen" Click="PopupPreviewClicked" Style="{StaticResource Primary}" HorizontalAlignment="Left" />
            </StackPanel></Border>
          </StackPanel>

          <StackPanel x:Name="AnimationsPage" Visibility="Collapsed">
            <Border Background="#E7EFED" CornerRadius="18" Padding="18" Margin="0,0,0,20"><StackPanel><TextBlock Text="A moment of clarity" FontSize="18" FontWeight="SemiBold" /><Viewbox Height="210" StretchDirection="DownOnly"><local:IndicatorView x:Name="MotionIndicator" /></Viewbox><Button Content="Play animation" Click="PlayAnimationClicked" Style="{StaticResource Primary}" HorizontalAlignment="Center" /></StackPanel></Border>
            <Border Style="{StaticResource Surface}"><StackPanel>
              <StackPanel Style="{StaticResource Field}"><TextBlock Text="Timing preset" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="PresetChoice" SelectionChanged="PresetChanged" AutomationProperties.Name="Animation timing preset" /></StackPanel>
              <StackPanel Style="{StaticResource Field}"><TextBlock Text="Animation style" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="AnimationChoice" SelectedValuePath="Key" ItemTemplate="{StaticResource OptionLabel}" SelectedValue="{Binding AnimationStyle}" AutomationProperties.Name="Animation style" /></StackPanel>
              <StackPanel Style="{StaticResource Field}"><TextBlock Text="Display duration · ms" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding PopupDurationMs, ValidatesOnExceptions=True}" AutomationProperties.Name="Display duration" /></StackPanel>
              <StackPanel Style="{StaticResource Field}"><TextBlock Text="Fade in · ms" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding FadeInDurationMs, ValidatesOnExceptions=True}" AutomationProperties.Name="Fade in duration" /></StackPanel>
              <StackPanel Style="{StaticResource Field}"><TextBlock Text="Fade out · ms" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding FadeOutDurationMs, ValidatesOnExceptions=True}" AutomationProperties.Name="Fade out duration" /></StackPanel>
              <StackPanel Style="{StaticResource Field}"><TextBlock Text="Speed · 0.25–4×" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding AnimationSpeed, ValidatesOnExceptions=True}" AutomationProperties.Name="Animation speed" /></StackPanel>
              <Grid Style="{StaticResource SwitchRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Reduce motion" FontWeight="SemiBold" /><TextBlock Text="Use an instant transition. Windows animation preferences are also respected." Style="{StaticResource Caption}" /></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ReduceMotion}" AutomationProperties.Name="Reduce motion" /></Grid>
            </StackPanel></Border>
          </StackPanel>

          <StackPanel x:Name="LanguagesPage" Visibility="Collapsed">
            <Border Background="#133D3B" CornerRadius="18" Padding="26"><StackPanel><ui:SymbolIcon Symbol="LocalLanguage24" FontSize="36" Foreground="#9DDCD1" HorizontalAlignment="Left" /><TextBlock x:Name="DetectedLanguage" Text="Detected automatically" FontSize="28" Foreground="White" Margin="0,14,0,8" /><TextBlock Text="Your active Windows keyboard layout." Foreground="#C2DCD7" /></StackPanel></Border>
            <TextBlock Text="Keyboard languages" Style="{StaticResource SectionTitle}" /><TextBlock Text="Languages come from Windows. Select a row to personalize its label." Style="{StaticResource Caption}" Margin="0,0,0,12" />
            <ListBox x:Name="LanguageList" DisplayMemberPath="Label" SelectionChanged="LanguageSelected" MinHeight="100" AutomationProperties.Name="Keyboard languages" />
            <Border Style="{StaticResource Surface}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Display label" Style="{StaticResource FieldLabel}" /><TextBox x:Name="LanguageLabelEditor" IsEnabled="False" AutomationProperties.Name="Custom language label" /><Button Content="Save label" Click="SaveLanguageClicked" Style="{StaticResource Action}" HorizontalAlignment="Left" Margin="0,14,0,0" /><TextBlock x:Name="LanguageMessage" Style="{StaticResource Caption}" Margin="0,10,0,0" /></StackPanel></Border>
            <TextBlock Text="Detection reads keyboard layout identifiers. Typed text is never collected." Style="{StaticResource Caption}" Margin="0,18,0,0" />
          </StackPanel>

          <StackPanel x:Name="CorrectionPage" Visibility="Collapsed">
            <Border Background="#133D3B" CornerRadius="18" Padding="26" Margin="0,0,0,20"><StackPanel><TextBlock Text="Wrong layout. Right words." FontSize="24" FontWeight="SemiBold" Foreground="White" /><TextBlock Text="Fix selected text, or the connected segment just before the caret in supported fields." Foreground="#C2DCD7" Margin="0,10,0,0" /></StackPanel></Border>
            <Border Style="{StaticResource Surface}"><StackPanel>
              <Grid Style="{StaticResource SwitchRow}"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Fix typing layout" FontWeight="SemiBold" /><TextBlock Text="Works from the tray, with settings closed." Style="{StaticResource Caption}" /></StackPanel><ui:ToggleSwitch x:Name="CorrectionEnabledSwitch" Grid.Column="1" Click="CorrectionEnabledClicked" AutomationProperties.Name="Enable typing correction" /></Grid>
              <StackPanel Style="{StaticResource Field}">
                <TextBlock Text="Global shortcut" Style="{StaticResource FieldLabel}" />
                <Grid Margin="0,4,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <Border x:Name="ShortcutRecorderBox"
                          Background="White"
                          BorderBrush="{StaticResource Line}"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="16,12"
                          Cursor="Hand"
                          Focusable="True"
                          PreviewKeyDown="ShortcutRecorderKeyDown"
                          PreviewKeyUp="ShortcutRecorderKeyUp"
                          PreviewMouseDown="ShortcutRecorderMouseDown"
                          LostFocus="ShortcutRecorderLostFocus"
                          AutomationProperties.Name="Global keyboard shortcut recorder"
                          AutomationProperties.HelpText="Click to record a new keyboard shortcut. Press Escape to cancel.">
                    <DockPanel LastChildFill="True">
                      <Border x:Name="RecordingDot"
                              DockPanel.Dock="Right"
                              Width="8" Height="8"
                              CornerRadius="4"
                              Background="{StaticResource Accent}"
                              VerticalAlignment="Center"
                              Margin="12,0,0,0"
                              Visibility="Collapsed" />
                      <Border x:Name="RecordingBadge"
                              DockPanel.Dock="Right"
                              Background="{StaticResource AccentSoft}"
                              CornerRadius="4"
                              Padding="8,2"
                              VerticalAlignment="Center"
                              Margin="8,0,0,0"
                              Visibility="Collapsed">
                        <TextBlock Text="Recording · Esc to cancel" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                      </Border>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon x:Name="ShortcutIcon" Symbol="Keyboard24" FontSize="18" Foreground="{StaticResource Muted}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="ShortcutDisplay"
                                   Text="F8"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </DockPanel>
                  </Border>

                  <Button x:Name="ResetShortcutButton"
                          Grid.Column="1"
                          Content="Reset to default"
                          Click="ResetShortcutClicked"
                          Style="{StaticResource Action}"
                          Margin="10,0,0,0"
                          VerticalAlignment="Stretch"
                          AutomationProperties.Name="Reset shortcut to default" />
                </Grid>
                <TextBlock x:Name="CorrectionShortcutStatus" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                <TextBlock x:Name="ShortcutHelpText" Text="Click the box and press your shortcut. Supports single function keys (e.g. F8), or combinations with Ctrl, Alt, Shift, and Win." Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
              </StackPanel>
              <TextBlock Text="Supported layout pair" Style="{StaticResource FieldLabel}" /><TextBlock Text="English (US) ↔ Arabic (101)" Margin="0,0,0,22" Foreground="{StaticResource Accent}" />
              <StackPanel Style="{StaticResource Field}"><TextBlock Text="Correction direction" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="CorrectionDirectionChoice" SelectedValuePath="Key" ItemTemplate="{StaticResource OptionLabel}" SelectedValue="{Binding TypingCorrectionDirection}" AutomationProperties.Name="Correction direction" /><TextBlock Text="Auto refuses mixed English/Arabic text. Choose a direction explicitly to correct mixed text." Style="{StaticResource Caption}" Margin="0,8,0,0" /></StackPanel>
              <Grid Style="{StaticResource SwitchRow}"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Switch keyboard after correction" FontWeight="SemiBold" /><TextBlock Text="Off by default. Continue typing in the corrected language." Style="{StaticResource Caption}" /></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding SwitchLayoutAfterCorrection}" AutomationProperties.Name="Switch keyboard after correction" /></Grid>
            </StackPanel></Border>
            <TextBlock Text="Try a layout fix" Style="{StaticResource SectionTitle}" /><Border Style="{StaticResource Surface}"><StackPanel><TextBlock Text="Type ;dt; and choose Fix sample. Select just a part, or leave the caret after the word." Style="{StaticResource Caption}" Margin="0,0,0,14" /><TextBox x:Name="CorrectionDemo" Text=";dt;" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Typing correction sample" /><Button Content="Fix sample" Click="FixSampleClicked" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,16,0,0" /><TextBlock x:Name="CorrectionDemoStatus" Margin="0,12,0,0" Style="{StaticResource Caption}" /></StackPanel></Border>
            <TextBlock Text="Only runs when requested. No clipboard access, no typing history, no text logging. Passwords, protected fields, and elevated apps are excluded. Unsupported fields are left unchanged." Style="{StaticResource Caption}" Margin="0,20,0,0" />
          </StackPanel>

          <StackPanel x:Name="AdvancedPage" Visibility="Collapsed">
            <Border Background="{StaticResource AccentSoft}" CornerRadius="12" Padding="18"><TextBlock Text="For fine-tuning and troubleshooting. Most people can keep the defaults." Foreground="{StaticResource Accent}" /></Border>
            <TextBlock Text="Detection preferences" Style="{StaticResource SectionTitle}" /><Border Style="{StaticResource Surface}"><StackPanel>
              <Grid Style="{StaticResource SwitchRow}"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Language variants" FontWeight="SemiBold" /><TextBlock Text="Also show changes between regional keyboard layouts." Style="{StaticResource Caption}" /></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowOnVariantChange}" AutomationProperties.Name="Show on language variant changes" /></Grid>
              <Grid Style="{StaticResource SwitchRow}"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Focus changes" FontWeight="SemiBold" /><TextBlock Text="Allow caret activation when you enter another text field." Style="{StaticResource Caption}" /></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowPopupOnFocusChange}" AutomationProperties.Name="Show on focus changes" /></Grid>
            </StackPanel></Border>
            <TextBlock Text="Diagnostics" Style="{StaticResource SectionTitle}" /><Border Style="{StaticResource Surface}"><StackPanel>
              <Grid Style="{StaticResource SwitchRow}"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Debug logging" FontWeight="SemiBold" /><TextBlock Text="Record indicator events locally, without typed text." Style="{StaticResource Caption}" /></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding DebugLogging}" AutomationProperties.Name="Enable debug logging" /></Grid>
              <TextBlock Text="Settings are saved locally in your Windows profile." Style="{StaticResource Caption}" /><Button Content="Open data folder" Click="OpenDataClicked" Style="{StaticResource Action}" HorizontalAlignment="Left" Margin="0,14,0,0" />
            </StackPanel></Border>
          </StackPanel>

          <StackPanel x:Name="AboutPage" Visibility="Collapsed">
            <Border Style="{StaticResource Surface}" CornerRadius="18" Padding="28">
              <StackPanel>
                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <!-- Circular avatar with AE fallback -->
                  <Grid Width="96" Height="96" VerticalAlignment="Top" Margin="0,0,24,0">
                    <Border CornerRadius="48" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Line}" BorderThickness="1.5">
                      <TextBlock Text="AE" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border CornerRadius="48">
                      <Border.Clip>
                        <EllipseGeometry Center="48,48" RadiusX="48" RadiusY="48" />
                      </Border.Clip>
                      <Image x:Name="DeveloperAvatar" Stretch="UniformToFill" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                  </Grid>

                  <!-- Developer Details -->
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,4">
                      <TextBlock x:Name="DeveloperName" Text="Ahmad Essawii." FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,10,0" VerticalAlignment="Center" />
                      <Border Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="Developer" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                      </Border>
                    </WrapPanel>

                    <TextBlock x:Name="DeveloperUsername" Text="@ahmadessawii06" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,0,0,10" />
                    <TextBlock x:Name="DeveloperBio" Text="NNU - CAP , Senior C++ Developer." FontSize="13" Foreground="{StaticResource Ink}" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <WrapPanel x:Name="DeveloperMetaPanel">
                      <Border x:Name="CompanyTag" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="9,5" Margin="0,0,8,6">
                        <StackPanel Orientation="Horizontal">
                          <ui:SymbolIcon Symbol="Building24" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                          <TextBlock x:Name="DeveloperCompany" Text="من رام الله الى القدس وبالعكس" FontSize="12" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                      <Border x:Name="LocationTag" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="9,5" Margin="0,0,8,6" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                          <ui:SymbolIcon Symbol="Location24" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                          <TextBlock x:Name="DeveloperLocation" Text="" FontSize="12" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </WrapPanel>
                  </StackPanel>
                </Grid>

                <!-- Actions -->
                <WrapPanel Margin="0,0,0,24">
                  <Button x:Name="ViewProfileButton" Click="ViewGitHubProfileClicked" Style="{StaticResource Primary}" Margin="0,0,10,6" AutomationProperties.Name="View GitHub Profile">
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Symbol="Open24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <TextBlock Text="View GitHub Profile" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Click="RepositoryClicked" Style="{StaticResource Action}" Margin="0,0,10,6" AutomationProperties.Name="View project repository on GitHub">
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Symbol="Code24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <TextBlock Text="Project Repository" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Click="RefreshProfileClicked" Style="{StaticResource Action}" Padding="10,9" Margin="0,0,0,6" ToolTip="Refresh profile from GitHub" AutomationProperties.Name="Refresh GitHub Profile">
                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                  </Button>
                </WrapPanel>

                <!-- Divider -->
                <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,20" />

                <!-- GitHub Statistics -->
                <TextBlock Text="GitHub Statistics" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,12" />
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <!-- Repositories -->
                  <Border Grid.Column="0" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                    <StackPanel>
                      <TextBlock x:Name="StatRepos" Text="31" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                      <TextBlock Text="Repositories" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                    </StackPanel>
                  </Border>

                  <!-- Followers -->
                  <Border Grid.Column="2" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                    <StackPanel>
                      <TextBlock x:Name="StatFollowers" Text="9" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                      <TextBlock Text="Followers" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                    </StackPanel>
                  </Border>

                  <!-- Following -->
                  <Border Grid.Column="4" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                    <StackPanel>
                      <TextBlock x:Name="StatFollowing" Text="6" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                      <TextBlock Text="Following" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                    </StackPanel>
                  </Border>
                </Grid>

                <!-- Status & App Info -->
                <DockPanel Margin="0,16,0,0">
                  <TextBlock x:Name="ProfileSyncStatus" Text="Profile connected to GitHub" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                  <TextBlock x:Name="VersionLabel" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                </DockPanel>
              </StackPanel>
            </Border>

            <!-- Footer -->
            <TextBlock Text="Made with passion by Ahmad Essawii." Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,24,0,12" />
            <TextBlock x:Name="LinkStatus" Style="{StaticResource Caption}" HorizontalAlignment="Center" Visibility="Collapsed" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="30,8" Background="White"><DockPanel><TextBlock Text="{Binding SaveStatus}" FontSize="11" Foreground="{StaticResource Muted}" /><TextBlock DockPanel.Dock="Right" Text="MADE FOR MULTILINGUAL MINDS" FontSize="9" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" /></DockPanel></Border>
    </Grid>
  </Grid>
</Window>
