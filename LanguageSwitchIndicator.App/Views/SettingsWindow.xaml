<Window x:Class="LanguageSwitchIndicator.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:LanguageSwitchIndicator.Views"
        Title="Language Switch Indicator"
        Width="1180" Height="820" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Canvas}"
        Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI, -apple-system, sans-serif"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Themes/Product.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <DataTemplate x:Key="OptionLabel">
        <TextBlock Text="{Binding Value}" FontSize="13" />
      </DataTemplate>

      <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      </Style>

      <Style x:Key="Field" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,0,16" />
      </Style>

      <Style x:Key="SwitchRow" TargetType="Grid">
        <Setter Property="Margin" Value="0,6,0,6" />
      </Style>

      <Style TargetType="ui:ToggleSwitch" BasedOn="{StaticResource DefaultUiToggleSwitchStyle}">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="16,0,0,0" />
      </Style>

      <!-- Monitor Screen Interactive Position Button Style -->
      <Style x:Key="MonitorPosBtn" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="6" />
        <Setter Property="Background" Value="{DynamicResource MonitorButtonBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MonitorButtonBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="9"
                      Width="56" Height="44">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.25" Color="#000000" />
                </Border.Effect>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.95" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Background="{DynamicResource Canvas}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="224" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ===================================================================== -->
    <!-- SIDEBAR NAVIGATION                                                    -->
    <!-- ===================================================================== -->
    <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,20,14,16">

        <!-- App Branding Header -->
        <StackPanel DockPanel.Dock="Top" Margin="6,0,6,22">
          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- App Icon Squircle -->
            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource Accent}" VerticalAlignment="Center">
              <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18" Color="#0D9488" />
              </Border.Effect>
              <ui:SymbolIcon Symbol="Keyboard24" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <!-- Titles -->
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Language Switch" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
              <TextBlock Text="Indicator" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,1,0,0" />
            </StackPanel>
          </Grid>
          <Border Height="1" Background="{DynamicResource LineSubtle}" Margin="0,14,0,10" />
          <TextBlock Text="PREFERENCES" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedLight}" Margin="4,0,0,0" />
        </StackPanel>

        <!-- Sidebar Footer -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
          <!-- About & Developer Navigation Button -->
          <Button x:Name="AboutButton"
                  Style="{StaticResource Action}"
                  Click="AboutClicked"
                  HorizontalContentAlignment="Left"
                  Padding="10,8"
                  AutomationProperties.Name="About the developer">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:SymbolIcon Symbol="Person24" FontSize="17" Foreground="{DynamicResource Muted}" Margin="0,0,10,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="About &amp; Developer" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <!-- Live Status Card -->
          <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="7" Height="7" CornerRadius="3.5" Background="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="One indicator · Active screen" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,1,0,0" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <!-- Main Navigation List -->
        <ListBox x:Name="Navigation"
                 Background="Transparent"
                 BorderThickness="0"
                 ItemContainerStyle="{StaticResource NavigationItem}"
                 SelectionChanged="NavigationChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Settings pages">
          <ListBoxItem Tag="General">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ui:SymbolIcon Symbol="Settings24" FontSize="18" Margin="0,0,11,0" VerticalAlignment="Center" />
              <TextBlock Text="General" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Appearance">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ui:SymbolIcon Symbol="Color24" FontSize="18" Margin="0,0,11,0" VerticalAlignment="Center" />
              <TextBlock Text="Appearance" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Position">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ui:SymbolIcon Symbol="Desktop24" FontSize="18" Margin="0,0,11,0" VerticalAlignment="Center" />
              <TextBlock Text="Position" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Animations">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ui:SymbolIcon Symbol="Flash24" FontSize="18" Margin="0,0,11,0" VerticalAlignment="Center" />
              <TextBlock Text="Animations" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Languages">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ui:SymbolIcon Symbol="LocalLanguage24" FontSize="18" Margin="0,0,11,0" VerticalAlignment="Center" />
              <TextBlock Text="Languages" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Typing correction" AutomationProperties.Name="Typing correction">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="18" Margin="0,0,11,0" VerticalAlignment="Center" />
              <TextBlock Text="Typing correction" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Advanced">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ui:SymbolIcon Symbol="Options24" FontSize="18" Margin="0,0,11,0" VerticalAlignment="Center" />
              <TextBlock Text="Advanced" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ===================================================================== -->
    <!-- MAIN CONTENT VIEWPORT                                                 -->
    <!-- ===================================================================== -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="36" />
      </Grid.RowDefinitions>

      <ScrollViewer x:Name="PageScroll"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="32,28,32,28">
        <StackPanel x:Name="PageRoot" MaxWidth="1040" HorizontalAlignment="Stretch">

          <!-- Page Header & Breadcrumb -->
          <DockPanel Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="PREFERENCES" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedLight}" />
              <TextBlock Text="/" FontSize="10.5" Foreground="{DynamicResource MutedLight}" Margin="6,0" />
              <TextBlock Text="DESKTOP" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
            </StackPanel>
            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{DynamicResource SurfaceSecondary}" CornerRadius="4" Padding="7,2">
              <TextBlock Text="WINDOWS 11 / 10" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" />
            </Border>
          </DockPanel>

          <TextBlock x:Name="PageTitle" Text="General" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,4,0,4" />
          <TextBlock x:Name="PageDescription" Text="Your language, always in view. Make the indicator work your way." Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,0,0,22" LineHeight="19" />

          <!-- ================================================================= -->
          <!-- 1. GENERAL PAGE                                                   -->
          <!-- ================================================================= -->
          <StackPanel x:Name="GeneralPage">
            <!-- Modern Hero Status Card -->
            <Border CornerRadius="14" Padding="22,18" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" Margin="0,0,0,20">
              <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.12" Color="#0F172A" />
              </Border.Effect>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Background="#132E35" BorderBrush="#0D9488" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                      <TextBlock Text="ACTIVE MONITOR" FontSize="9.5" FontWeight="Bold" Foreground="#2DD4BF" />
                    </Border>
                    <TextBlock Text="{Binding Status}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="Instant Visual Feedback" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
                  <TextBlock Text="A subtle, unobtrusive visual cue for the language you are about to write." Foreground="#94A3B8" FontSize="12.5" MaxWidth="520" HorizontalAlignment="Left" />
                </StackPanel>
                <Border Grid.Column="1" Width="54" Height="54" CornerRadius="12" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" VerticalAlignment="Center" Margin="16,0,0,0">
                  <ui:SymbolIcon Symbol="Keyboard24" Foreground="#2DD4BF" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Border>

            <!-- Group 1: Indicator Behavior -->
            <TextBlock Text="Indicator Behavior" Style="{StaticResource SectionTitle}" Margin="0,4,0,8" />
            <Border Style="{StaticResource Surface}">
              <StackPanel>
                <Grid Style="{StaticResource SwitchRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Enable indicator" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Ink}" />
                    <TextBlock Text="Show a language cue on screen during input changes." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                  </StackPanel>
                  <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}" AutomationProperties.Name="Enable indicator" />
                </Grid>

                <Border Height="1" Background="{DynamicResource LineSubtle}" Margin="0,10,0,10" />

                <Grid Style="{StaticResource SwitchRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Pause for now" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Ink}" />
                    <TextBlock Text="Temporarily suppress popup cues while keeping your configuration." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                  </StackPanel>
                  <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsPaused}" AutomationProperties.Name="Pause indicator" />
                </Grid>

                <Border Height="1" Background="{DynamicResource LineSubtle}" Margin="0,10,0,10" />

                <Grid Margin="0,4,0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Show the indicator when" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Ink}" />
                    <TextBlock Text="Choose what trigger events trigger the language indicator." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                  </StackPanel>
                  <ComboBox x:Name="TriggerChoice" Grid.Column="1" SelectedValuePath="Key" ItemTemplate="{StaticResource OptionLabel}" SelectedValue="{Binding TriggerMode}" AutomationProperties.Name="Popup trigger" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- Group 2: System & Startup -->
            <TextBlock Text="System &amp; Startup" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Surface}">
              <StackPanel>
                <Grid Style="{StaticResource SwitchRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Launch with Windows" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Ink}" />
                    <TextBlock Text="Start automatically in the background when you sign into Windows." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                  </StackPanel>
                  <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchAtStartup, ValidatesOnExceptions=True}" AutomationProperties.Name="Launch with Windows" />
                </Grid>

                <Border Height="1" Background="{DynamicResource LineSubtle}" Margin="0,10,0,10" />

                <Grid Style="{StaticResource SwitchRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Start minimized to tray" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Ink}" />
                    <TextBlock Text="Launch silently into the taskbar notification tray without opening settings." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                  </StackPanel>
                  <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding StartMinimized}" AutomationProperties.Name="Start in the tray" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ================================================================= -->
          <!-- 2. APPEARANCE PAGE                                                -->
          <!-- ================================================================= -->
          <StackPanel x:Name="AppearancePage" Visibility="Collapsed">
            <Grid x:Name="AppearanceLayout">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="EditorColumn" Width="*" />
                <ColumnDefinition x:Name="PreviewColumn" Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <!-- Editor Panel -->
              <Border x:Name="AppearanceEditor" Style="{StaticResource Surface}">
                <StackPanel>
                  <TextBlock Text="Visual Styling" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                  <TextBlock Text="Fine-tune how the application and indicator look. Changes are saved automatically." Style="{StaticResource Caption}" Margin="0,2,0,18" />

                  <!-- Settings Window Theme -->
                  <StackPanel Style="{StaticResource Field}">
                    <TextBlock Text="Settings window theme" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="AppThemeChoice" SelectedItem="{Binding AppTheme}" AutomationProperties.Name="Settings window theme" />
                    <TextBlock Text="Choose between clean light mode, immersive dark mode, or follow Windows." Style="{StaticResource Caption}" Margin="0,4,0,0" />
                  </StackPanel>

                  <Border Height="1" Background="{DynamicResource LineSubtle}" Margin="0,4,0,16" />

                  <!-- Indicator Size -->
                  <StackPanel Style="{StaticResource Field}">
                    <TextBlock Text="Indicator size" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="SizeChoice" SelectedIndex="{Binding IndicatorSize}" AutomationProperties.Name="Indicator size" />
                  </StackPanel>

                  <!-- Theme -->
                  <StackPanel Style="{StaticResource Field}">
                    <TextBlock Text="Indicator popup theme" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="ThemeChoice" SelectedItem="{Binding Theme}" AutomationProperties.Name="Color mode" />
                  </StackPanel>

                  <!-- Typeface & Size -->
                  <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="2*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Typeface" Style="{StaticResource FieldLabel}" />
                      <TextBox Text="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Typeface" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Text size · px" Style="{StaticResource FieldLabel}" />
                      <TextBox Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Text size" />
                    </StackPanel>
                  </Grid>

                  <Border Height="1" Background="{DynamicResource LineSubtle}" Margin="0,4,0,14" />

                  <!-- Custom Colors -->
                  <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Custom colors" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Ink}" />
                      <TextBlock Text="Override the default dark/light theme palette." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding UseCustomColors}" AutomationProperties.Name="Use custom colors" />
                  </Grid>

                  <StackPanel IsEnabled="{Binding UseCustomColors}" Margin="0,0,0,8">
                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Background · HEX" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Background color" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="Text &amp; icon · HEX" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Text color" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>

                  <!-- Shape & Surface Expander -->
                  <Expander Header="Geometry &amp; Elevation" Margin="0,6,0,0">
                    <StackPanel Margin="0,14,0,4">
                      <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Min width · px" Style="{StaticResource FieldLabel}" />
                          <TextBox Text="{Binding PopupWidth, ValidatesOnExceptions=True}" AutomationProperties.Name="Minimum width" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="Min height · px" Style="{StaticResource FieldLabel}" />
                          <TextBox Text="{Binding PopupHeight, ValidatesOnExceptions=True}" AutomationProperties.Name="Minimum height" />
                        </StackPanel>
                      </Grid>

                      <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Corner radius · px" Style="{StaticResource FieldLabel}" />
                          <TextBox Text="{Binding CornerRadius, ValidatesOnExceptions=True}" AutomationProperties.Name="Corner radius" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="Opacity · 0.1–1" Style="{StaticResource FieldLabel}" />
                          <TextBox Text="{Binding BackgroundOpacity, ValidatesOnExceptions=True}" AutomationProperties.Name="Background opacity" />
                        </StackPanel>
                      </Grid>

                      <StackPanel Style="{StaticResource Field}">
                        <TextBlock Text="Shadow intensity · 0–1" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ShadowIntensity, ValidatesOnExceptions=True}" AutomationProperties.Name="Shadow intensity" />
                      </StackPanel>
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Border>

              <!-- Live Preview Panel -->
              <StackPanel x:Name="PreviewPanel" Grid.Column="1" Margin="20,0,0,0">
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="18">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.05" Color="#000000" />
                  </Border.Effect>
                  <StackPanel>
                    <!-- Mock Window Titlebar -->
                    <DockPanel Margin="0,0,0,14">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#CBD5E1" Margin="0,0,5,0" />
                        <Border Width="8" Height="8" CornerRadius="4" Background="#E2E8F0" Margin="0,0,5,0" />
                        <Border Width="8" Height="8" CornerRadius="4" Background="#E2E8F0" Margin="0,0,10,0" />
                        <TextBlock Text="LIVE WORKSPACE PREVIEW" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" />
                      </StackPanel>
                      <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{DynamicResource AccentSoft}" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="REALTIME" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                      </Border>
                    </DockPanel>

                    <!-- Preview Stage -->
                    <Border CornerRadius="10" Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="14">
                      <Grid MinHeight="260">
                        <StackPanel VerticalAlignment="Top">
                          <Border Height="4" Width="48" Background="#E2E8F0" HorizontalAlignment="Left" CornerRadius="2" Margin="0,0,0,12" />
                          <TextBlock Text="Active Editor Window" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Ink}" />
                          <TextBlock Text="Testing keyboard language switch visual..." FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                          <Border Background="{DynamicResource LineSubtle}" Height="1" Margin="0,12,0,0" />
                        </StackPanel>

                        <Viewbox MaxWidth="280" MaxHeight="210" StretchDirection="DownOnly" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                          <local:IndicatorView x:Name="LiveIndicator" />
                        </Viewbox>
                      </Grid>
                    </Border>

                    <Button Style="{StaticResource Primary}" Click="TestSwitchClicked" Margin="0,16,0,8" AutomationProperties.Name="Test switch in preview">
                      <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Test language switch" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <TextBlock Text="Toggles between English and Arabic to test colors and typography." Style="{StaticResource Caption}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </StackPanel>

          <!-- ================================================================= -->
          <!-- 3. POSITION PAGE (MONITOR VISUALIZATION REDESIGN)                 -->
          <!-- ================================================================= -->
          <StackPanel x:Name="PositionPage" Visibility="Collapsed">

            <!-- Monitor Visualization Card -->
            <Border Style="{StaticResource Surface}" Margin="0,0,0,16">
              <StackPanel>
                <DockPanel Margin="0,0,0,16">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Interactive Screen Placement" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                    <TextBlock Text="Click a screen zone on the monitor below to anchor the indicator." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                  </StackPanel>
                  <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="8,4">
                    <TextBlock Text="ACTIVE DISPLAY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                  </Border>
                </DockPanel>

                <!-- Monitor Assembly -->
                <StackPanel HorizontalAlignment="Center" Margin="0,6,0,10">
                  <!-- Outer Monitor Bezel Frame -->
                  <Border Width="520" Height="260" CornerRadius="14" Background="#1E293B" BorderBrush="#334155" BorderThickness="2" Padding="8,8,8,12">
                    <Border.Effect>
                      <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.18" Color="#0F172A" />
                    </Border.Effect>
                    <Grid>
                      <!-- Monitor Display Screen Canvas -->
                      <Border CornerRadius="8" Background="#0F172A" ClipToBounds="True">
                        <Grid>
                          <!-- Desktop Wallpaper Gradient -->
                          <Border>
                            <Border.Background>
                              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#091E28" Offset="0.0" />
                                <GradientStop Color="#0F172A" Offset="0.5" />
                                <GradientStop Color="#132E35" Offset="1.0" />
                              </LinearGradientBrush>
                            </Border.Background>
                          </Border>

                          <!-- Wallpaper Radial Center Glow -->
                          <Ellipse Width="260" Height="140" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.14">
                            <Ellipse.Fill>
                              <RadialGradientBrush>
                                <GradientStop Color="#0D9488" Offset="0" />
                                <GradientStop Color="Transparent" Offset="1" />
                              </RadialGradientBrush>
                            </Ellipse.Fill>
                          </Ellipse>

                          <!-- Mock Windows Desktop Taskbar at Bottom -->
                          <Border VerticalAlignment="Bottom" Height="22" Background="#26000000" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0">
                            <DockPanel Margin="10,0">
                              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="7" Height="7" CornerRadius="1.5" Background="#64748B" Margin="0,0,6,0" />
                                <Border Width="14" Height="3" CornerRadius="1.5" Background="#475569" Margin="0,0,4,0" />
                                <Border Width="14" Height="3" CornerRadius="1.5" Background="#475569" />
                              </StackPanel>
                              <TextBlock DockPanel.Dock="Right" Text="12:00 PM" FontSize="8.5" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </DockPanel>
                          </Border>

                          <!-- Interactive 3x3 Position Map on Screen -->
                          <Grid x:Name="PositionMap" Margin="10,10,10,26">
                            <Grid.RowDefinitions>
                              <RowDefinition Height="*" />
                              <RowDefinition Height="*" />
                              <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Row 0: Top Left, Top Center, Top Right -->
                            <Button Tag="TopLeft" Grid.Row="0" Grid.Column="0" Click="PositionClicked" Style="{StaticResource MonitorPosBtn}" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="Top left" AutomationProperties.Name="Top left">
                              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Keyboard24" FontSize="15" Foreground="White" HorizontalAlignment="Center" />
                                <TextBlock Text="English" FontSize="8" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,1,0,0" />
                              </StackPanel>
                            </Button>

                            <Button Tag="TopCenter" Grid.Row="0" Grid.Column="1" Click="PositionClicked" Style="{StaticResource MonitorPosBtn}" HorizontalAlignment="Center" VerticalAlignment="Top" ToolTip="Top center" AutomationProperties.Name="Top center">
                              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Keyboard24" FontSize="15" Foreground="White" HorizontalAlignment="Center" />
                                <TextBlock Text="English" FontSize="8" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,1,0,0" />
                              </StackPanel>
                            </Button>

                            <Button Tag="TopRight" Grid.Row="0" Grid.Column="2" Click="PositionClicked" Style="{StaticResource MonitorPosBtn}" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Top right" AutomationProperties.Name="Top right">
                              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Keyboard24" FontSize="15" Foreground="White" HorizontalAlignment="Center" />
                                <TextBlock Text="English" FontSize="8" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,1,0,0" />
                              </StackPanel>
                            </Button>

                            <!-- Row 1: Center -->
                            <Button Tag="Center" Grid.Row="1" Grid.Column="1" Click="PositionClicked" Style="{StaticResource MonitorPosBtn}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Center" AutomationProperties.Name="Center">
                              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Keyboard24" FontSize="15" Foreground="White" HorizontalAlignment="Center" />
                                <TextBlock Text="English" FontSize="8" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,1,0,0" />
                              </StackPanel>
                            </Button>

                            <!-- Row 2: Bottom Left, Bottom Center, Bottom Right -->
                            <Button Tag="BottomLeft" Grid.Row="2" Grid.Column="0" Click="PositionClicked" Style="{StaticResource MonitorPosBtn}" HorizontalAlignment="Left" VerticalAlignment="Bottom" ToolTip="Bottom left" AutomationProperties.Name="Bottom left">
                              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Keyboard24" FontSize="15" Foreground="White" HorizontalAlignment="Center" />
                                <TextBlock Text="English" FontSize="8" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,1,0,0" />
                              </StackPanel>
                            </Button>

                            <Button Tag="BottomCenter" Grid.Row="2" Grid.Column="1" Click="PositionClicked" Style="{StaticResource MonitorPosBtn}" HorizontalAlignment="Center" VerticalAlignment="Bottom" ToolTip="Bottom center" AutomationProperties.Name="Bottom center">
                              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Keyboard24" FontSize="15" Foreground="White" HorizontalAlignment="Center" />
                                <TextBlock Text="English" FontSize="8" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,1,0,0" />
                              </StackPanel>
                            </Button>

                            <Button Tag="BottomRight" Grid.Row="2" Grid.Column="2" Click="PositionClicked" Style="{StaticResource MonitorPosBtn}" HorizontalAlignment="Right" VerticalAlignment="Bottom" ToolTip="Bottom right" AutomationProperties.Name="Bottom right">
                              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Keyboard24" FontSize="15" Foreground="White" HorizontalAlignment="Center" />
                                <TextBlock Text="English" FontSize="8" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,1,0,0" />
                              </StackPanel>
                            </Button>
                          </Grid>
                        </Grid>
                      </Border>

                      <!-- Top WebCam / Sensor Dot -->
                      <Border Width="4" Height="4" CornerRadius="2" Background="#475569" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0" />
                    </Grid>
                  </Border>

                  <!-- Monitor Stand Neck & Base -->
                  <StackPanel HorizontalAlignment="Center" Margin="0,-1,0,0">
                    <Border Width="34" Height="18" Background="#334155" CornerRadius="0,0,2,2" HorizontalAlignment="Center" />
                    <Border Width="110" Height="6" Background="#475569" CornerRadius="3" HorizontalAlignment="Center">
                      <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.12" />
                      </Border.Effect>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Placement Controls & Preview Group -->
            <Border Style="{StaticResource Surface}">
              <StackPanel>
                <!-- Placement Dropdown Row -->
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Placement mode" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Ink}" />
                    <TextBlock Text="Synchronized with screen selector. Includes dynamic caret positioning." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                  </StackPanel>
                  <ComboBox x:Name="PlacementChoice" Grid.Column="1" SelectedValuePath="Key" ItemTemplate="{StaticResource OptionLabel}" SelectedValue="{Binding Placement}" AutomationProperties.Name="Indicator placement" />
                </Grid>

                <Border Height="1" Background="{DynamicResource LineSubtle}" Margin="0,0,0,16" />

                <!-- Action Row -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Test on active display" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Ink}" />
                    <TextBlock Text="Flashes the real floating indicator at the chosen position without switching keyboards." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                  </StackPanel>
                  <Button Grid.Column="1" Click="PopupPreviewClicked" Style="{StaticResource Primary}" Padding="16,9" AutomationProperties.Name="Preview on this screen">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <ui:SymbolIcon Symbol="Desktop24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <TextBlock Text="Preview on this screen" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ================================================================= -->
          <!-- 4. ANIMATIONS PAGE                                                -->
          <!-- ================================================================= -->
          <StackPanel x:Name="AnimationsPage" Visibility="Collapsed">
            <!-- Stage Card -->
            <Border Style="{StaticResource Surface}" Margin="0,0,0,16">
              <StackPanel>
                <DockPanel Margin="0,0,0,12">
                  <TextBlock Text="Motion Preview Stage" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                  <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Click="PlayAnimationClicked" Style="{StaticResource Primary}" Padding="14,7" AutomationProperties.Name="Play animation">
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Symbol="Flash24" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                      <TextBlock Text="Play animation" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DockPanel>

                <!-- Stage Canvas -->
                <Border CornerRadius="10" Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="14">
                  <Viewbox Height="180" StretchDirection="DownOnly">
                    <local:IndicatorView x:Name="MotionIndicator" />
                  </Viewbox>
                </Border>
              </StackPanel>
            </Border>

            <!-- Timing & Preset Card -->
            <Border Style="{StaticResource Surface}">
              <StackPanel>
                <TextBlock Text="Animation Dynamics" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,0,0,14" />

                <!-- Presets & Style -->
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Timing preset" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="PresetChoice" SelectionChanged="PresetChanged" AutomationProperties.Name="Animation timing preset" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Animation style" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="AnimationChoice" SelectedValuePath="Key" ItemTemplate="{StaticResource OptionLabel}" SelectedValue="{Binding AnimationStyle}" AutomationProperties.Name="Animation style" />
                  </StackPanel>
                </Grid>

                <!-- Durations Grid -->
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Duration · ms" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding PopupDurationMs, ValidatesOnExceptions=True}" AutomationProperties.Name="Display duration" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Fade in · ms" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding FadeInDurationMs, ValidatesOnExceptions=True}" AutomationProperties.Name="Fade in duration" />
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <TextBlock Text="Fade out · ms" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding FadeOutDurationMs, ValidatesOnExceptions=True}" AutomationProperties.Name="Fade out duration" />
                  </StackPanel>
                </Grid>

                <!-- Speed Multiplier -->
                <StackPanel Style="{StaticResource Field}">
                  <TextBlock Text="Speed multiplier · 0.25–4×" Style="{StaticResource FieldLabel}" />
                  <TextBox Text="{Binding AnimationSpeed, ValidatesOnExceptions=True}" AutomationProperties.Name="Animation speed" />
                </StackPanel>

                <Border Height="1" Background="{DynamicResource LineSubtle}" Margin="0,6,0,12" />

                <!-- Reduce Motion Accessibility Row -->
                <Grid Style="{StaticResource SwitchRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Reduce motion" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Ink}" />
                    <TextBlock Text="Use an instant transition without fade or scaling. System preferences are respected." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                  </StackPanel>
                  <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ReduceMotion}" AutomationProperties.Name="Reduce motion" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ================================================================= -->
          <!-- 5. LANGUAGES PAGE                                                 -->
          <!-- ================================================================= -->
          <StackPanel x:Name="LanguagesPage" Visibility="Collapsed">
            <!-- Detection Hero Card -->
            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="14" Padding="22,18" Margin="0,0,0,18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Width="7" Height="7" CornerRadius="3.5" Background="#2DD4BF" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="WINDOWS INPUT MONITOR" FontSize="10" FontWeight="Bold" Foreground="#2DD4BF" />
                  </StackPanel>
                  <TextBlock x:Name="DetectedLanguage" Text="Detected automatically" FontSize="22" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4" />
                  <TextBlock Text="Active Windows keyboard layout queried in real time." Foreground="#94A3B8" FontSize="12.5" />
                </StackPanel>
                <Border Grid.Column="1" Width="48" Height="48" CornerRadius="12" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" VerticalAlignment="Center">
                  <ui:SymbolIcon Symbol="LocalLanguage24" FontSize="24" Foreground="#2DD4BF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Border>

            <!-- Language List Card -->
            <Border Style="{StaticResource Surface}">
              <StackPanel>
                <TextBlock Text="Installed Keyboard Layouts" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                <TextBlock Text="Select a language below to customize its display badge." Style="{StaticResource Caption}" Margin="0,2,0,14" />

                <ListBox x:Name="LanguageList" DisplayMemberPath="Label" SelectionChanged="LanguageSelected" MinHeight="110" AutomationProperties.Name="Keyboard languages" />

                <Border Height="1" Background="{DynamicResource LineSubtle}" Margin="0,16,0,14" />

                <!-- Label Editor -->
                <StackPanel Style="{StaticResource Field}">
                  <TextBlock Text="Custom display badge" Style="{StaticResource FieldLabel}" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LanguageLabelEditor" IsEnabled="False" AutomationProperties.Name="Custom language label" />
                    <Button Grid.Column="1" Content="Save label" Click="SaveLanguageClicked" Style="{StaticResource Primary}" Margin="10,0,0,0" AutomationProperties.Name="Save label" />
                  </Grid>
                  <TextBlock x:Name="LanguageMessage" Style="{StaticResource Caption}" Foreground="{StaticResource Accent}" Margin="0,8,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>

            <TextBlock Text="Privacy Note: Detection reads keyboard layout identifiers only. Typed text is never collected, stored, or transmitted." Style="{StaticResource Caption}" Margin="0,12,0,0" />
          </StackPanel>

          <!-- ================================================================= -->
          <!-- 6. TYPING CORRECTION PAGE                                         -->
          <!-- ================================================================= -->
          <StackPanel x:Name="CorrectionPage" Visibility="Collapsed">
            <!-- Hero Card -->
            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="14" Padding="22,18" Margin="0,0,0,18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Wrong layout. Right words." FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4" />
                  <TextBlock Text="Instantly converts mistakenly typed text between English and Arabic keyboard layouts." Foreground="#94A3B8" FontSize="12.5" MaxWidth="520" />
                </StackPanel>
                <Border Grid.Column="1" Width="48" Height="48" CornerRadius="12" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" VerticalAlignment="Center">
                  <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="24" Foreground="#2DD4BF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Border>

            <!-- Service Configuration Card -->
            <Border Style="{StaticResource Surface}">
              <StackPanel>
                <!-- Master Toggle -->
                <Grid Style="{StaticResource SwitchRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Enable typing layout correction" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Ink}" />
                    <TextBlock Text="Runs system-wide from the tray, even when settings are closed." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                  </StackPanel>
                  <ui:ToggleSwitch x:Name="CorrectionEnabledSwitch" Grid.Column="1" Click="CorrectionEnabledClicked" AutomationProperties.Name="Enable typing correction" />
                </Grid>

                <Border Height="1" Background="{DynamicResource LineSubtle}" Margin="0,12,0,14" />

                <!-- Global Shortcut Recorder -->
                <StackPanel Style="{StaticResource Field}">
                  <TextBlock Text="Global activation shortcut" Style="{StaticResource FieldLabel}" />
                  <Grid Margin="0,2,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ShortcutRecorderBox"
                            Background="{DynamicResource InputBackground}"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Cursor="Hand"
                            Focusable="True"
                            PreviewKeyDown="ShortcutRecorderKeyDown"
                            PreviewKeyUp="ShortcutRecorderKeyUp"
                            PreviewMouseDown="ShortcutRecorderMouseDown"
                            LostFocus="ShortcutRecorderLostFocus"
                            AutomationProperties.Name="Global keyboard shortcut recorder"
                            AutomationProperties.HelpText="Click to record a new keyboard shortcut. Press Escape to cancel.">
                      <DockPanel LastChildFill="True">
                        <Border x:Name="RecordingDot"
                                DockPanel.Dock="Right"
                                Width="8" Height="8"
                                CornerRadius="4"
                                Background="{StaticResource Accent}"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0"
                                Visibility="Collapsed" />
                        <Border x:Name="RecordingBadge"
                                DockPanel.Dock="Right"
                                Background="{DynamicResource AccentSoft}"
                                CornerRadius="4"
                                Padding="8,2"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0"
                                Visibility="Collapsed">
                          <TextBlock Text="Recording · Esc to cancel" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <ui:SymbolIcon x:Name="ShortcutIcon" Symbol="Keyboard24" FontSize="18" Foreground="{DynamicResource Muted}" Margin="0,0,10,0" VerticalAlignment="Center" />
                          <TextBlock x:Name="ShortcutDisplay"
                                     Text="F8"
                                     FontSize="14"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource Ink}"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                      </DockPanel>
                    </Border>

                    <Button x:Name="ResetShortcutButton"
                            Grid.Column="1"
                            Content="Reset to default"
                            Click="ResetShortcutClicked"
                            Style="{StaticResource Action}"
                            Margin="10,0,0,0"
                            VerticalAlignment="Stretch"
                            AutomationProperties.Name="Reset shortcut to default" />
                  </Grid>
                  <TextBlock x:Name="CorrectionShortcutStatus" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                  <TextBlock x:Name="ShortcutHelpText" Text="Click the box and press your shortcut. Supports single function keys (e.g. F8), or combinations with Ctrl, Alt, Shift, and Win." Style="{StaticResource Caption}" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" />
                </StackPanel>

                <Border Height="1" Background="{DynamicResource LineSubtle}" Margin="0,6,0,14" />

                <!-- Layout Pair -->
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Supported language pair" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Ink}" />
                    <TextBlock Text="Converts between English and Arabic phonetic key mappings." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                  </StackPanel>
                  <Border Grid.Column="1" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                    <TextBlock Text="English (US) ↔ Arabic (101)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                  </Border>
                </Grid>

                <!-- Correction Direction -->
                <StackPanel Style="{StaticResource Field}">
                  <TextBlock Text="Correction direction" Style="{StaticResource FieldLabel}" />
                  <ComboBox x:Name="CorrectionDirectionChoice" SelectedValuePath="Key" ItemTemplate="{StaticResource OptionLabel}" SelectedValue="{Binding TypingCorrectionDirection}" AutomationProperties.Name="Correction direction" />
                  <TextBlock Text="Auto refuses mixed English/Arabic text. Choose a direction explicitly to correct mixed text." Style="{StaticResource Caption}" Margin="0,6,0,0" />
                </StackPanel>

                <Border Height="1" Background="{DynamicResource LineSubtle}" Margin="0,6,0,14" />

                <!-- Switch keyboard after correction -->
                <Grid Style="{StaticResource SwitchRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Switch keyboard layout after correction" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Ink}" />
                    <TextBlock Text="Automatically aligns your active Windows keyboard with the converted language." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                  </StackPanel>
                  <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding SwitchLayoutAfterCorrection}" AutomationProperties.Name="Switch keyboard after correction" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- Interactive Sandbox Card -->
            <TextBlock Text="Interactive Conversion Sandbox" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Surface}">
              <StackPanel>
                <TextBlock Text="Type or paste sample text (e.g. ';dt;' which maps to 'علي') and click Fix sample." Style="{StaticResource Caption}" Margin="0,0,0,10" />
                <TextBox x:Name="CorrectionDemo" Text=";dt;" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Typing correction sample" />
                <Button Content="Fix sample text" Click="FixSampleClicked" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,12,0,0" AutomationProperties.Name="Fix sample text" />
                <TextBlock x:Name="CorrectionDemoStatus" Margin="0,8,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource Accent}" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ================================================================= -->
          <!-- 7. ADVANCED PAGE                                                  -->
          <!-- ================================================================= -->
          <StackPanel x:Name="AdvancedPage" Visibility="Collapsed">
            <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
              <TextBlock Text="Advanced parameters for troubleshooting and specific desktop setups. Recommended defaults are pre-configured." FontSize="12.5" Foreground="{StaticResource Accent}" />
            </Border>

            <TextBlock Text="Detection Engine" Style="{StaticResource SectionTitle}" Margin="0,4,0,8" />
            <Border Style="{StaticResource Surface}">
              <StackPanel>
                <Grid Style="{StaticResource SwitchRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Language variant changes" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Ink}" />
                    <TextBlock Text="Show indicator popup when switching between regional dialects of the same language." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                  </StackPanel>
                  <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowOnVariantChange}" AutomationProperties.Name="Show on language variant changes" />
                </Grid>

                <Border Height="1" Background="{DynamicResource LineSubtle}" Margin="0,10,0,10" />

                <Grid Style="{StaticResource SwitchRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Show on focus changes" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Ink}" />
                    <TextBlock Text="Briefly trigger a cue when entering a new text input field." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                  </StackPanel>
                  <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowPopupOnFocusChange}" AutomationProperties.Name="Show on focus changes" />
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Text="Diagnostics &amp; Storage" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Surface}">
              <StackPanel>
                <Grid Style="{StaticResource SwitchRow}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Debug event logging" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Ink}" />
                    <TextBlock Text="Record indicator timing and window lifecycle events locally. Keystrokes are never logged." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                  </StackPanel>
                  <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding DebugLogging}" AutomationProperties.Name="Enable debug logging" />
                </Grid>

                <Border Height="1" Background="{DynamicResource LineSubtle}" Margin="0,10,0,12" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Application data folder" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Ink}" />
                    <TextBlock Text="Configuration files and offline profile caches are stored in your Windows AppData folder." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                  </StackPanel>
                  <Button Content="Open data folder" Click="OpenDataClicked" Style="{StaticResource Action}" Grid.Column="1" AutomationProperties.Name="Open data folder" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ================================================================= -->
          <!-- 8. ABOUT & DEVELOPER PAGE                                         -->
          <!-- ================================================================= -->
          <StackPanel x:Name="AboutPage" Visibility="Collapsed">
            <Border Style="{StaticResource Surface}" CornerRadius="16" Padding="26">
              <StackPanel>
                <!-- Profile Header Card -->
                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <!-- Circular avatar with AE fallback -->
                  <Grid Width="96" Height="96" VerticalAlignment="Top" Margin="0,0,22,0">
                    <Border CornerRadius="48" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Line}" BorderThickness="1.5">
                      <TextBlock Text="AE" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border CornerRadius="48">
                      <Border.Clip>
                        <EllipseGeometry Center="48,48" RadiusX="48" RadiusY="48" />
                      </Border.Clip>
                      <Image x:Name="DeveloperAvatar" Stretch="UniformToFill" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                  </Grid>

                  <!-- Developer Details -->
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,4">
                      <TextBlock x:Name="DeveloperName" Text="Ahmad Essawii." FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,0,10,0" VerticalAlignment="Center" />
                      <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="Developer" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                      </Border>
                    </WrapPanel>

                    <TextBlock x:Name="DeveloperUsername" Text="@ahmadessawii06" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,0,0,8" />
                    <TextBlock x:Name="DeveloperBio" Text="NNU - CAP , Senior C++ Developer." FontSize="13" Foreground="{DynamicResource InkSecondary}" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <WrapPanel x:Name="DeveloperMetaPanel">
                      <Border x:Name="CompanyTag" Background="{DynamicResource SurfaceSecondary}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,6">
                        <StackPanel Orientation="Horizontal">
                          <ui:SymbolIcon Symbol="Building24" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                          <TextBlock x:Name="DeveloperCompany" Text="من رام الله الى القدس وبالعكس" FontSize="12" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                      <Border x:Name="LocationTag" Background="{DynamicResource SurfaceSecondary}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,6" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                          <ui:SymbolIcon Symbol="Location24" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                          <TextBlock x:Name="DeveloperLocation" Text="" FontSize="12" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </WrapPanel>
                  </StackPanel>
                </Grid>

                <!-- Actions Button Row -->
                <WrapPanel Margin="0,0,0,20">
                  <Button x:Name="ViewProfileButton" Click="ViewGitHubProfileClicked" Style="{StaticResource Primary}" Margin="0,0,10,6" AutomationProperties.Name="View GitHub Profile">
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Symbol="Open24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <TextBlock Text="View GitHub Profile" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Click="RepositoryClicked" Style="{StaticResource Action}" Margin="0,0,10,6" AutomationProperties.Name="View project repository on GitHub">
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Symbol="Code24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <TextBlock Text="Project Repository" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Click="RefreshProfileClicked" Style="{StaticResource Action}" Padding="10,8" Margin="0,0,0,6" ToolTip="Refresh profile from GitHub" AutomationProperties.Name="Refresh GitHub Profile">
                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="15" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                  </Button>
                </WrapPanel>

                <!-- Divider -->
                <Border Height="1" Background="{DynamicResource LineSubtle}" Margin="0,0,0,18" />

                <!-- GitHub Statistics Row -->
                <TextBlock Text="GitHub Statistics" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,0,0,10" />
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <!-- Repositories -->
                  <Border Grid.Column="0" Background="{DynamicResource SurfaceSecondary}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <StackPanel>
                      <TextBlock x:Name="StatRepos" Text="31" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Ink}" />
                      <TextBlock Text="Repositories" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                  </Border>

                  <!-- Followers -->
                  <Border Grid.Column="2" Background="{DynamicResource SurfaceSecondary}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <StackPanel>
                      <TextBlock x:Name="StatFollowers" Text="9" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Ink}" />
                      <TextBlock Text="Followers" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                  </Border>

                  <!-- Following -->
                  <Border Grid.Column="4" Background="{DynamicResource SurfaceSecondary}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <StackPanel>
                      <TextBlock x:Name="StatFollowing" Text="6" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Ink}" />
                      <TextBlock Text="Following" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                  </Border>
                </Grid>

                <!-- Status & App Info -->
                <DockPanel Margin="0,14,0,0">
                  <TextBlock x:Name="ProfileSyncStatus" Text="Profile connected to GitHub" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                  <TextBlock x:Name="VersionLabel" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                </DockPanel>
              </StackPanel>
            </Border>

            <!-- Footer -->
            <TextBlock Text="Made with passion by Ahmad Essawii." Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,20,0,10" />
            <TextBlock x:Name="LinkStatus" Style="{StaticResource Caption}" HorizontalAlignment="Center" Visibility="Collapsed" />
          </StackPanel>

        </StackPanel>
      </ScrollViewer>

      <!-- Bottom Application Status Bar -->
      <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,6" Background="{DynamicResource SurfaceBrush}">
        <DockPanel>
          <TextBlock Text="{Binding SaveStatus}" FontSize="11.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
          <TextBlock DockPanel.Dock="Right" Text="LANGUAGE SWITCH INDICATOR" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource MutedLight}" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
